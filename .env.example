# Copy to .env and adjust as needed. docker-compose reads this file.

# --- Postgres ---
POSTGRES_USER=repolens
POSTGRES_PASSWORD=repolens
POSTGRES_DB=repolens
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full SQLAlchemy URL used by the app (host = service name inside compose network)
DATABASE_URL=postgresql+psycopg2://repolens:repolens@postgres:5432/repolens

# --- Redis (Celery broker + result/cache) ---
REDIS_URL=redis://redis:6379/0

# --- App ---
# Where the worker clones repos before analysis (inside the container)
CLONE_DIR=/tmp/repolens_clones
# Guard rails for public deployment
CLONE_TIMEOUT_SECONDS=120
MAX_REPO_SIZE_MB=500
# Cache: if the same repo_url was analyzed within this window, reuse it
ANALYSIS_CACHE_TTL_SECONDS=3600

# CORS origins for the frontend (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
